APP_NAME=MyCar
APP_ENV=local
APP_KEY=
# Desenvolvimento: true. Uso real: APP_ENV=production e APP_DEBUG=false (nunca exponha detalhes de erro).
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Atrás de HTTPS, ative: SESSION_SECURE_COOKIE=true (cookies HttpOnly e SameSite=Lax já são o padrão).
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Tabela FIPE (API pública Parallelum v2). O token é opcional.
FIPE_BASE_URL=https://fipe.parallelum.com.br/api/v2
FIPE_TOKEN=
FIPE_TIMEOUT=5
FIPE_RETRIES=2
FIPE_CACHE_TTL=86400

# Dados de demonstração (opcional). Com true, `php artisan db:seed` também cria os veículos "[DEMO]".
# Para uso real, mantenha false. Remover: php artisan mycar:demo clear
MYCAR_DEMO=false
